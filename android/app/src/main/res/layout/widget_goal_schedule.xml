<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/goal_schedule_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="목표 자격증 일정"
        android:textColor="#302C2E"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/goal_schedule_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="등록된 목표 자격증이 없습니다."
        android:textColor="#817B7D"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/goal_schedule_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:scrollbars="vertical" />
</LinearLayout>
