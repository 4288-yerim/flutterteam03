<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="112dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_item_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/goal_qualification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="자격 구분"
            android:textColor="#817B7D"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_main_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★ 대표 목표"
            android:textColor="#E96387"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/goal_certificate_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="자격증 이름"
        android:textColor="#302C2E"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/goal_round"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="시험 회차"
        android:textColor="#817B7D"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/goal_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D-0"
            android:textColor="#E96387"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/goal_exam_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="시험 유형 · 2026.01.01"
            android:textColor="#302C2E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
